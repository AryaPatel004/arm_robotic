# Python bytecode cache - regenerated automatically, version-specific, never share it
__pycache__/
*.pyc
*.pyo

# Virtual environments - each machine builds its own from requirements.txt
venv/
.venv/

# Runtime output - generated by running the code, not source
arm_control/run_log.csv

# Calibration artifacts - tied to one specific camera mount/position.
# Uncomment these two if the whole team shares one fixed physical rig and
# wants everyone to pull the same calibration instead of each re-running
# calibrate.py:
# arm_control/homography.json
# arm_control/reference_frame.png
arm_control/homography.json
arm_control/reference_frame.png

# Large trained model artifact - not source, and can be a big binary blob
arm_control/obstacle_model.tflite
